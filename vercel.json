{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/order/:path*", "destination": "/" },
    { "source": "/admin/:path*", "destination": "/" },
    { "source": "/tickets", "destination": "/" },
    { "source": "/checkout", "destination": "/" },
    { "source": "/bag", "destination": "/" },
    { "source": "/events", "destination": "/" },
    { "source": "/venues", "destination": "/" },
    { "source": "/legal", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(video|audio|img)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(noise.png|IMG_1990-scaled.jpeg)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    }
  ]
}

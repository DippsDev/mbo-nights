# Copy to .env.local (local dev) and add the same keys in
# Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API. The publishable key is safe in the browser.
# NEVER put the secret / service_role key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The FNB number customers send Pay2Cell payments to, and the name they should see.
VITE_PAY2CELL_NUMBER=71 234 567
VITE_PAY2CELL_NAME=MBO Nights

# Your live address, used in the ticket links sent on WhatsApp.
# Without it, links use whatever address the admin page is open on (e.g. localhost in dev).
VITE_SITE_URL=https://your-site.vercel.app

# Leave unset (or false) in production until you're ready to sell.
# `npm run dev` always shows the ticket pages regardless.
VITE_TICKETS_LIVE=false
